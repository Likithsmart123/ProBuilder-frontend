<?xml version="1.0" encoding="utf-8"?>
<!-- Sent message bubble: WhatsApp green with rounded corners + right tail -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:left="1dp" android:top="1dp">
        <shape>
            <solid android:color="#20000000"/>
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp"/>
        </shape>
    </item>
    <!-- Main bubble -->
    <item android:bottom="1dp" android:right="1dp">
        <shape>
            <solid android:color="#D9FDD3"/>
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp"/>
            <stroke android:width="0.5dp" android:color="#B2DFA8"/>
        </shape>
    </item>
</layer-list>
