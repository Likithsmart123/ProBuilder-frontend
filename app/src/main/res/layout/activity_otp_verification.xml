<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="24dp"
    tools:context=".OtpVerificationActivity">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_arrow_back_black"
        android:contentDescription="Back"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <!-- Header similar to Login -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/desc_app_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Verify Email"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvEmailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:text="Enter the 6-digit code sent to your email"
        android:textSize="16sp"/>

    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvEmailLabel"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/otpBox1"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_box_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="1" />

        <EditText
            android:id="@+id/otpBox2"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_box_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="2" />

        <EditText
            android:id="@+id/otpBox3"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_box_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="3" />

        <EditText
            android:id="@+id/otpBox4"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_box_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="4" />

        <EditText
            android:id="@+id/otpBox5"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_box_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="5" />

        <EditText
            android:id="@+id/otpBox6"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_margin="4dp"
            android:background="@drawable/otp_box_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="6" />

    </LinearLayout>

    <Button
        android:id="@+id/btnVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/otpContainer"
        android:layout_marginTop="24dp"
        android:background="@drawable/gradient_button_background"
        android:padding="16dp"
        android:text="Verify Code"
        android:textColor="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btnVerifyOtp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend in 60s"
            android:textColor="#757575"/>

        <Button
            android:id="@+id/btnResendOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend Code"
            android:enabled="false"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#1E6FE3"/>
    </LinearLayout>

</RelativeLayout>
