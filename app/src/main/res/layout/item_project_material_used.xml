<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMaterialImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_widgets"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquare" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvMaterialName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cement (53 Grade)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tvMaterialQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Used: 150 Bags"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"/>
                
            <TextView
                android:id="@+id/tvMaterialSpecifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type/Size: ..."
                android:textSize="13sp"
                android:textColor="#888888"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>
             
            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining: 50 Bags"
                android:textSize="12sp"
                android:textColor="@android:color/holo_green_dark"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
