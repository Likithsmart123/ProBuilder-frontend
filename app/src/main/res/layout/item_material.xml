<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <View
            android:id="@+id/status_border"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#E53935"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Material Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMaterialImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/img_cement"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/status_border"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Material Name -->
        <TextView
            android:id="@+id/tvMaterialName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Cement Bags"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivMaterialImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivWarning" />

        <!-- Delete Icon -->
        <ImageView
            android:id="@+id/ivDeleteMaterial"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            app:tint="#D32F2F"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvMaterialName"
            app:layout_constraintBottom_toBottomOf="@id/tvMaterialName" />

        <!-- Warning Icon -->
        <ImageView
            android:id="@+id/ivWarning"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_warning"
            app:tint="#FDD835"
            android:visibility="gone"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/ivDeleteMaterial"
            app:layout_constraintTop_toTopOf="@id/tvMaterialName"
            app:layout_constraintBottom_toBottomOf="@id/tvMaterialName" />

        <!-- Min Stock -->
        <TextView
            android:id="@+id/tvMinStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Min: 50 bags"
            android:textSize="13sp"
            android:textColor="#757575"
            app:layout_constraintStart_toStartOf="@id/tvMaterialName"
            app:layout_constraintTop_toBottomOf="@id/tvMaterialName" />

        <!-- Current Stock -->
        <TextView
            android:id="@+id/tvCurrentStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Current: 15 bags"
            android:textColor="#424242"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvMaterialName"
            app:layout_constraintTop_toBottomOf="@id/tvMinStock" />

        <!-- Status Label -->
        <TextView
            android:id="@+id/tvStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_critical_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Critical"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>