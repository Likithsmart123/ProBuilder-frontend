<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1E6FE3"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Quotation Detail"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Construction Estimate"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_client"
                        android:textColor="#757575"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tvDetailClient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="John Doe"
                        android:textSize="16sp"
                        android:textColor="#000000"/>
                    <TextView
                        android:id="@+id/tvDetailClientContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="john@example.com | 1234567890"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_project"
                        android:textColor="#757575"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tvDetailProject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="House Application"
                        android:textSize="16sp"
                        android:textColor="#000000"/>
                    <TextView
                        android:id="@+id/tvDetailProjectLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location: Banjara Hills"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_amount_simple"
                        android:textColor="#757575"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tvDetailAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="₹ 50,000"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_date_simple"
                        android:textColor="#757575"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2024-01-12"
                        android:textSize="16sp"
                        android:textColor="#000000"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_desc_items"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Details..."
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"/>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnDownloadPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download PDF"
                android:backgroundTint="#FF5722"
                android:padding="12dp"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:icon="@android:drawable/stat_sys_download" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
