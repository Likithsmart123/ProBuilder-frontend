<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_image_placeholder" 
        android:background="#EEEEEE"/>
        <!-- Note: ic_image_placeholder might not exist, checking drawables next. Safe to use srcCompat or standard src with existing drawable like ic_menu_gallery or similar if needed. I'll use a generic background color if src fails visually. -->

</androidx.cardview.widget.CardView>
